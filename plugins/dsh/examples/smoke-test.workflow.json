{
  "id": "smoke-test",
  "name": "冒烟测试",
  "version": "0.1.0",
  "nodes": [
    {
      "id": "start",
      "type": "flow:start",
      "outputs": [{ "name": "out", "type": "data" }]
    },
    {
      "id": "greet",
      "type": "data:assign",
      "inputs": [{ "name": "in", "type": "data" }],
      "outputs": [{ "name": "out", "type": "data" }],
      "params": {
        "value": "HNFlow 冒烟测试：这是一条由 data:assign 生成的固定消息。"
      }
    },
    {
      "id": "confirm",
      "type": "human:task",
      "inputs": [{ "name": "in", "type": "data" }],
      "outputs": [{ "name": "note", "type": "data" }],
      "params": {
        "description": "确认上面的消息后继续；note 会作为下一步的输入。"
      }
    },
    {
      "id": "result",
      "type": "data:assign",
      "inputs": [{ "name": "in", "type": "data" }],
      "outputs": [{ "name": "out", "type": "data" }],
      "params": {
        "value": "人工已确认，冒烟流程结束。"
      }
    },
    {
      "id": "end",
      "type": "flow:end",
      "inputs": [{ "name": "in", "type": "data" }]
    }
  ],
  "edges": [
    { "source": "start", "source_port": "out", "target": "greet", "target_port": "in" },
    { "source": "greet", "source_port": "out", "target": "confirm", "target_port": "in" },
    { "source": "confirm", "source_port": "note", "target": "result", "target_port": "in" },
    { "source": "result", "source_port": "out", "target": "end", "target_port": "in" }
  ],
  "metadata": {
    "canvas": {
      "positions": {
        "start": { "x": 0, "y": 140 },
        "greet": { "x": 230, "y": 140 },
        "confirm": { "x": 480, "y": 140 },
        "result": { "x": 730, "y": 140 },
        "end": { "x": 980, "y": 140 }
      }
    }
  }
}
