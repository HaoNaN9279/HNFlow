{
  "name": "@hnflow/desktop",
  "version": "0.1.3",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "bun build src/main.ts --target=node --format=cjs --external electron --outfile=dist/main.js",
    "build:preload": "bun build src/preload.ts --target=node --format=cjs --external electron --outfile=dist/preload.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev": "vite dev",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@ant-design/icons": "5",
    "@antv/x6": "2",
    "@antv/x6-plugin-clipboard": "2.1.6",
    "@antv/x6-plugin-dnd": "2.1.1",
    "@antv/x6-plugin-history": "2.2.4",
    "@antv/x6-plugin-keyboard": "2.2.3",
    "@antv/x6-plugin-selection": "2.2.2",
    "@antv/x6-plugin-snapline": "2.1.7",
    "@antv/x6-react-shape": "2",
    "antd": "5",
    "react": "18",
    "react-dom": "18"
  }
}
